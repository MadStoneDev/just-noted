# Copy to .env.local and fill in values. Never commit real secrets.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only: used by webhook/admin routes to bypass RLS. Keep secret.
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3050

# --- Health check (/api/health) ---
# Optional, server-only. A small table that the anon role can read, used to
# prove the database is actually answering. Suggested: roadmap_items (already
# readable by guests). If unset, the check falls back to the PostgREST root, so
# leaving this blank is fine. Never use the service_role key here.
HEALTH_TABLE=

# --- Upstash Redis (guest notes + rate limiting) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Upstash QStash (scheduled cleanup) ---
QSTASH_URL=
QSTASH_TOKEN=
# Shared secret checked by /api/admin/cleanup
CLEANUP_API_KEY=
# QStash request-signature verification keys (Upstash QStash console). Used by
# /api/export/process to verify the account-export job. If QStash isn't
# configured, exports are built inline in the request instead of as a job.
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# --- Email (Resend) ---
# Either RESEND or RESEND_API_KEY is accepted.
RESEND=
RESEND_API_KEY=
MAILERSEND_API=

# --- reCAPTCHA (contact form) ---
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# --- Cloudflare Turnstile (auth / login captcha) ---
# Site key is public (used in the browser). The SECRET goes in the self-hosted
# GoTrue env (GOTRUE_SECURITY_CAPTCHA_SECRET), NOT in the Next.js app.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Cloudflare R2 (avatar + notebook cover storage) ---
# All server-side only. Uploads go through server actions; keys never reach the browser.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public base URL for the bucket (r2.dev URL or a custom domain), no trailing slash
R2_PUBLIC_URL=

# --- Cloudflare R2 (PRIVATE — chat media + account exports) ---
# A separate bucket with public access DISABLED. Objects are served only via
# short-lived presigned URLs to verified users — never a public URL. Uses its
# own least-privilege API token, kept apart from the public avatars config above.
R2_PRIVATE_BUCKET=
R2_PRIVATE_ACCESS_KEY_ID=
R2_PRIVATE_SECRET_ACCESS_KEY=
# Optional: leave blank to derive from R2_ACCOUNT_ID (same account). Set only for
# a different account or a jurisdiction endpoint (e.g. https://<id>.eu.r2.cloudflarestorage.com).
R2_PRIVATE_ENDPOINT=

# --- Anthropic (AI features) ---
ANTHROPIC_API_KEY=

# --- Stripe (billing, via Payment Links) ---
# JustNoted has one paid tier: "Scribe".
# Server secret + webhook signing secret (Stripe > Developers).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# The Scribe recurring price id — the webhook maps it to the 'scribe' tier.
STRIPE_SCRIBE_PRICE_ID=
# Scribe Payment Link URL (Stripe > Payment Links). Upgrade opens it with
# ?client_reference_id=<userId> so the webhook can map the checkout.
NEXT_PUBLIC_STRIPE_SCRIBE_PAYMENT_LINK=

# --- Analytics / monitoring (optional) ---
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_LOGROCKET_TOKEN=
