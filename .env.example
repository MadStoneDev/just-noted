# Copy to .env.local and fill in values. Never commit real secrets.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only: used by webhook/admin routes to bypass RLS. Keep secret.
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3050

# --- Upstash Redis (guest notes + rate limiting) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Upstash QStash (scheduled cleanup) ---
QSTASH_URL=
QSTASH_TOKEN=
# Shared secret checked by /api/admin/cleanup
CLEANUP_API_KEY=

# --- Email (Resend) ---
# Either RESEND or RESEND_API_KEY is accepted.
RESEND=
RESEND_API_KEY=
MAILERSEND_API=

# --- reCAPTCHA (contact form) ---
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# --- Cloudflare Turnstile (auth / login captcha) ---
# Site key is public (used in the browser). The SECRET goes in the self-hosted
# GoTrue env (GOTRUE_SECURITY_CAPTCHA_SECRET), NOT in the Next.js app.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Anthropic (AI features) ---
ANTHROPIC_API_KEY=

# --- Paddle (billing) ---
PADDLE_WEBHOOK_SECRET=
PADDLE_PRO_PRICE_ID=
PADDLE_TEAM_PRICE_ID=
NEXT_PUBLIC_PADDLE_PRO_PRICE_ID=
NEXT_PUBLIC_PADDLE_TEAM_PRICE_ID=

# --- Analytics / monitoring (optional) ---
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_LOGROCKET_TOKEN=
