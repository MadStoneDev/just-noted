# Copy to .env.local and fill in values. Never commit real secrets.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only: used by webhook/admin routes to bypass RLS. Keep secret.
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3050

# --- Health check (/api/health) ---
# Optional, server-only. A small table that the anon role can read, used to
# prove the database is actually answering. Suggested: roadmap_items (already
# readable by guests). If unset, the check falls back to the PostgREST root, so
# leaving this blank is fine. Never use the service_role key here.
HEALTH_TABLE=

# --- Valkey (guest notes, recovery keys, rate limiting) ---
# Self-hosted Valkey on the Coolify internal network. All keys are prefixed
# "justnoted:" (src/lib/redis.ts) so other projects can share the instance.
# Holds primary data (guest notes): run it with persistence and noeviction.
VALKEY_URL=redis://default:password@host:6379

# --- Scheduled jobs ---
# Shared secret checked by /api/admin/* (cleanup, migrations). The weekly
# cleanup is a Coolify Scheduled Task on the app container:
#   curl -fsS -X POST -H "x-api-key: $CLEANUP_API_KEY" http://localhost:3000/api/admin/cleanup
CLEANUP_API_KEY=

# --- Version history ---
# Autosave version trimming (the 50 Draft / 200 Scribe per-note cap) is PAUSED
# unless this is exactly "true": the older versions of notes damaged by the old
# cleanCorruptedMarkdown escape stripping are restore candidates. Leave unset
# (or "false") until those notes are restored; "true" resumes trimming, which
# then settles back toward the cap gradually as new autosaves arrive.
VERSION_HISTORY_TRIM_ENABLED=

# --- Email (Resend) ---
# Either RESEND or RESEND_API_KEY is accepted.
RESEND=
RESEND_API_KEY=
MAILERSEND_API=

# --- reCAPTCHA (contact form) ---
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# --- Cloudflare Turnstile (auth / login captcha) ---
# Site key is public (used in the browser). The SECRET goes in the self-hosted
# GoTrue env (GOTRUE_SECURITY_CAPTCHA_SECRET), NOT in the Next.js app.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Cloudflare R2 (avatar + notebook cover storage) ---
# All server-side only. Uploads go through server actions; keys never reach the browser.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public base URL for the bucket (r2.dev URL or a custom domain), no trailing slash
R2_PUBLIC_URL=

# --- Cloudflare R2 (PRIVATE — chat media + account exports) ---
# A separate bucket with public access DISABLED. Objects are served only via
# short-lived presigned URLs to verified users — never a public URL. Uses its
# own least-privilege API token, kept apart from the public avatars config above.
R2_PRIVATE_BUCKET=
R2_PRIVATE_ACCESS_KEY_ID=
R2_PRIVATE_SECRET_ACCESS_KEY=
# Optional: leave blank to derive from R2_ACCOUNT_ID (same account). Set only for
# a different account or a jurisdiction endpoint (e.g. https://<id>.eu.r2.cloudflarestorage.com).
R2_PRIVATE_ENDPOINT=

# --- Anthropic (AI features) ---
ANTHROPIC_API_KEY=

# --- Stripe (billing, via server-created Checkout Sessions) ---
# JustNoted has one paid tier: "Scribe", billed monthly or yearly.
# Server secret + webhook signing secret (Stripe > Developers).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Current Scribe prices — new checkouts use these (A$7/month, A$70/year).
STRIPE_SCRIBE_MONTHLY_PRICE_ID=
STRIPE_SCRIBE_YEARLY_PRICE_ID=
# The original A$5/month Scribe price. Never sold any more, but the webhook keeps
# recognising it so a subscription on it keeps Scribe. Leave it set.
STRIPE_SCRIBE_PRICE_ID=
# Checkout success/cancel URLs are built from NEXT_PUBLIC_APP_URL (above).

# --- Analytics / monitoring (optional) ---
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_LOGROCKET_TOKEN=
