; vitest (dev-only) declares a newer @types/node peer than the app pins
; (@types/node@^20, matching the Node 20 runtime). npm ci enforces peers
; strictly and fails ERESOLVE on this optional mismatch; legacy-peer-deps
; installs the already-locked tree without erroring. Dev tooling only —
; it does not affect the production bundle.
legacy-peer-deps=true
