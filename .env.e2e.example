# E2E test environment — copy to .env.e2e (gitignored) and fill in.
# The suite and the app server it builds use ONLY this file; every .env.local key
# is blanked for the test server, so anything not set here is off.
# Playwright refuses to run if this points at the production Supabase.

# Local Supabase (`supabase start`, then `supabase status` for the keys).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_APP_URL=http://localhost:3050

# Guest ("local") notes are stored in Valkey. Point at the throwaway instance
# from e2e/docker-compose.yml (never production — the suite refuses a URL equal
# to the one in .env.local).
VALKEY_URL=redis://127.0.0.1:6380

# Required by the recovery-key code paths; any value works locally.
RECOVERY_KEY_PEPPER=e2e-pepper

# Deliberately unset (the suite refuses to run if they're set): RESEND_API_KEY /
# RESEND (email), MAILERSEND_API, STRIPE_SECRET_KEY. Auth emails
# from the local Supabase go to its Mailpit inbox (http://127.0.0.1:54324),
# never to a real address.
